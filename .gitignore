.DS_Store
__pycache__/
.idea/
.vscode/


# per-run agent test output
testdir/
testdir-*/
template-testdir/

# Template packs are brand-internal: a company's own master, its renders and
# everything measured off them. The skill ships zero packs and reads whatever
# is installed here from disk, so being untracked costs nothing locally --
# and it makes the privacy boundary a path rather than a rule to remember.
# templates/README.md is the only thing in here a published skill contains.
skills/*/templates/*
!skills/*/templates/README.md
testing/delta-extract/

# Contact sheets of a brand's own slides, as images, wherever they land.
skills/*/company-template-*.jpg
skills/*/*-contact-sheet.jpg

# Scratch space, when /tmp is not writable. Normally removed on exit; this
# catches the runs that are killed before they get there.
.presentation-tmp/

# Packaged copies of a skill, for runs that install from a file rather than
# from this checkout. A snapshot of a commit that is already tracked here, so
# it duplicates the tree and goes stale the moment the skill changes.
# Regenerate rather than commit.
dist/
