.DS_Store
__pycache__/
.idea/
.vscode/

# Template packs are brand-internal: a company's own master, its renders and
# everything measured off them. The skill ships zero packs and reads whatever
# is installed here from disk, so being untracked costs nothing locally, and
# it makes the privacy boundary a path rather than a rule to remember.
# templates/README.md is the only thing in there a published skill contains.
skills/*/templates/*
!skills/*/templates/README.md

# Contact sheets of a brand's own slides, wherever they land.
skills/*/*-contact-sheet.jpg

# Scratch space, when /tmp is not writable. Normally removed on exit; this
# catches the runs that are killed before they get there.
.presentation-tmp/

# Build output of a deck run: the renders and the report land beside the deck.
render/
*-report.md
probe.pptx

# Packaged copies of a skill. A snapshot of a commit that is already tracked
# here; regenerate rather than commit.
dist/
